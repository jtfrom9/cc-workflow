{
  "name": "jtfrom9-cc-workflow",
  "description": "jtfrom9's Claude Code workflow helpers — small hooks that help avoid session-management mistakes",
  "version": "0.1.0",
  "author": {
    "name": "jtfrom9"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/banner.sh"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/python/relocate_plan.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/python/checkpoint.py", "--auto"]
          }
        ]
      }
    ]
  }
}
