{
  "name": "cc-workflow",
  "description": "CLAUDE.md injection, auto review/dev loops, daily reports, and a usage-aware status line for Claude Code.",
  "version": "0.13.0",
  "author": {
    "name": "jtfrom9 (Jun Tachikawa)"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/touch-session.sh"]
          }
        ]
      }
    ]
  }
}
